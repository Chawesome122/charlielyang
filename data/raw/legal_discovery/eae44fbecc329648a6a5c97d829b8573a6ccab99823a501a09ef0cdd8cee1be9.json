{"abstract":"In this rule, the Bureau of Industry and Security (BIS) amends the Export Administration Regulations (EAR) by adding 13 entities to the Entity List under the destination of the People's Republic of China (China). These entities have been determined by the U.S. Government to be acting contrary to the national security or foreign policy interests of the United States.","action":"Final rule.","agencies":[{"raw_name":"DEPARTMENT OF COMMERCE","name":"Commerce Department","id":54,"url":"https://www.federalregister.gov/agencies/commerce-department","json_url":"https://www.federalregister.gov/api/v1/agencies/54","parent_id":null,"slug":"commerce-department"},{"raw_name":"Bureau of Industry and Security","name":"Industry and Security Bureau","id":241,"url":"https://www.federalregister.gov/agencies/industry-and-security-bureau","json_url":"https://www.federalregister.gov/api/v1/agencies/241","parent_id":54,"slug":"industry-and-security-bureau"}],"body_html_url":"https://www.federalregister.gov/documents/full_text/html/2023/10/19/2023-23048.html","cfr_references":[{"chapter":null,"citation_url":null,"part":"744","title":15}],"citation":"88 FR 71991","comment_url":null,"comments_close_on":null,"correction_of":null,"corrections":[],"dates":"This rule is effective October 17, 2023.","disposition_notes":null,"docket_ids":["Docket No. 231013-0245"],"dockets":[{"supporting_documents":[],"agency_name":"BIS","documents":[{"comment_count":0,"comment_start_date":"2023-10-19","updated_at":"2024-03-05T16:56:35.043-05:00","comment_url":"https://www.regulations.gov/commenton/BIS-2024-0007-0001","allow_late_comments":null,"id":"BIS-2024-0007-0001","comment_end_date":null,"regulations_dot_gov_open_for_comment":false}],"supporting_documents_count":0,"id":"BIS-2024-0007","title":"Entity List Additions"}],"document_number":"2023-23048","effective_on":"2023-10-17","end_page":71994,"executive_order_notes":null,"executive_order_number":null,"full_text_xml_url":"https://www.federalregis